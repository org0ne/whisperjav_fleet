# WhisperJAV fleet agent -- one per worker machine.
#   sudo cp whisperjav-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now whisperjav-agent
#
# Must run as a user that can reach the media share and the GPU.
[Unit]
Description=WhisperJAV Fleet Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scott
WorkingDirectory=/opt/whisperjav-fleet/agent
Environment=FLEET_AGENT_CONFIG=/etc/whisperjav-agent/config.json
# Optional: load models from ~/.cache/huggingface only, never asking the hub.
# Makes every run immune to huggingface.co being down and to a stale token in
# ~/.cache/huggingface/token (the OAuth ones from `hf auth login` expire after
# 30 days, after which transformers reports every cached model as "not a valid
# model identifier").  The cost: a job naming a model not yet cached fails
# until someone downloads it by hand.
#Environment=HF_HUB_OFFLINE=1
ExecStart=/usr/bin/python3 /opt/whisperjav-fleet/agent/agent.py
Restart=always
RestartSec=10

# Signal only the agent on stop, not the whole control group: it then kills
# whisperjav's process group itself and requeues the file cleanly, instead of
# systemd terminating whisperjav directly and the run being recorded as a
# failure. Anything still alive after TimeoutStopSec is SIGKILLed.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
